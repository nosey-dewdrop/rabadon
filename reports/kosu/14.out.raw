{"type":"assistant","message":{"model":"claude-haiku-4-5-20251001","id":"msg_011CeMgZ7V5wsL2um4mcHDQa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KWdELGULSAfGRncowLCxip","name":"Read","input":{"file_path":"/Users/damummyphus/damla_projects_2026/rabadon-kosu2/core/wrap.mjs","limit":150},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":5,"cache_creation_input_tokens":724,"cache_read_input_tokens":35958,"cache_creation":{"ephemeral_5m_input_tokens":724,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_0192cvfjsyyZKrJXRYLswB6P","session_id":"81910dae-7509-4342-9a27-c75d4f682cbf","uuid":"3937c9b0-7b6d-4c83-82cc-0b9bf14462f1","request_id":"req_011CeMgZ6YXjXc7nVkcFmYXG","subagent_type":"Explore","task_description":"Trace counter in observe mode"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KWdELGULSAfGRncowLCxip","type":"tool_result","content":"1\t// rabadon wrap — one line into an existing codebase, and every LLM call\n2\t// becomes a checked, bounded, self-repairing step.\n3\t//\n4\t//   import { session } from 'rabadon';\n5\t//   const s = session({ maxCalls: 50, maxTokens: 200_000, maxRepairs: 2 });\n6\t//   const client = s.wrap(new Anthropic(), {\n7\t//     correct: [named('non-empty', (out) => out.text.length > 0 || 'empty completion')],\n8\t//   });\n9\t//   // use `client` exactly like before — rabadon now sits INSIDE every call.\n10\t//\n11\t// Where this shape comes from (verified against the field, 26.07.2026):\n12\t//   - Langfuse `observeOpenAI(client)` / Braintrust `wrapOpenAI(client)`:\n13\t//     the one-line client wrap is the adoption surface that works — BUT both\n14\t//     are passive; their own docs say they only log, never gate.\n15\t//   - Galileo Protect / Agent Control: the only inline one — code AWAITS the\n16\t//     verdict, then branches (allow / deny / canned override). No rewrite.\n17\t//   - Guardrails (ReAsk) / Instructor (max_retries): re-ask the model when ONE\n18\t//     structured output fails validation. Real prior art for repair — honored\n19\t//     in the comparison, not erased.\n20\t//   - rabadon: the wrap surface of the passive tools, the inline gate of\n21\t//     Galileo, and repair generalized past the single-output case: any step,\n22\t//     re-checked before it flows, spending from the same session budget.\n23\t//\n24\t// The session is the unit of protection: one shared budget across every call\n25\t// made through it, so a runaway loop cannot spend past the bound no matter\n26\t// how many wrapped clients it touches. Bound is enforced PRE-CALL (the spend\n27\t// is refused before it happens, not lamented after).\n28\t//\n29\t// FAIL-CLOSED ALSO MEANS: no un-gated side door. A wrapped client refuses the\n30\t// spend surfaces rabadon cannot count or check (responses/embeddings/batches/\n31\t// beta/streaming) instead of letting them silently bypass the budget. In\n32\t// 'observe' mode they flow — but loudly, ON RECORD, like every other failure.\n33\t\n34\timport { EV } from './bus.mjs';\n35\t\n36\t/** Error thrown when rabadon refuses to let a call proceed or flow onward. */\n37\texport class RabadonStop extends Error {\n38\t  constructor(reason, detail, extra = {}) {\n39\t    super(`rabadon ${reason}: ${detail}`);\n40\t    this.name = 'RabadonStop';\n41\t    this.reason = reason;   // 'RUNAWAY' | 'CHECK_FAILED' | 'UNWRAPPED'\n42\t    this.detail = detail;\n43\t    Object.assign(this, extra);\n44\t  }\n45\t}\n46\t\n47\t// Spend surfaces a wrapped client refuses to pass through un-gated. Anything\n48\t// on this list can cost tokens/money without going through gated(), which\n49\t// would make the budget a lie. Enumerated per provider shape; streaming is\n50\t// handled separately (it is a parameter, not a property).\n51\tconst UNGATED = {\n52\t  anthropic: { top: ['completions', 'batches', 'beta'], messages: ['stream', 'batches'] },\n53\t  openai: { top: ['responses', 'completions', 'embeddings', 'images', 'audio', 'batches', 'beta'] },\n54\t};\n55\t\n56\tfunction usageTokens(response) {\n57\t  // Anthropic: response.usage = { input_tokens, output_tokens }\n58\t  // OpenAI:    response.usage = { prompt_tokens, completion_tokens, total_tokens }\n59\t  const u = response && response.usage;\n60\t  if (!u) return 0;\n61\t  if (Number.isFinite(u.total_tokens)) return u.total_tokens;\n62\t  return (u.input_tokens || u.prompt_tokens || 0) + (u.output_tokens || u.completion_tokens || 0);\n63\t}\n64\t\n65\t/** Read the assistant's payload out of either provider's response shape.\n66\t * Tool calls COUNT as payload: an agentic response that only calls tools is\n67\t * not \"empty\", and a non-empty check must not fail-close legitimate work. */\n68\texport function responseText(response) {\n69\t  if (!response) return '';\n70\t  if (Array.isArray(response.content)) {\n71\t    // Anthropic: content blocks — text verbatim, tool_use serialized\n72\t    return response.content.map((b) =>\n73\t      b.type === 'text' ? b.text\n74\t      : b.type === 'tool_use' ? JSON.stringify({ tool_use: { name: b.name, input: b.input } })\n75\t      : '').join('');\n76\t  }\n77\t  if (Array.isArray(response.choices)) {\n78\t    // OpenAI: message content, else serialized tool_calls\n79\t    const m = response.choices[0] && response.choices[0].message;\n80\t    if (!m) return '';\n81\t    if (m.content) return m.content;\n82\t    if (Array.isArray(m.tool_calls) && m.tool_calls.length) return JSON.stringify(m.tool_calls);\n83\t    return '';\n84\t  }\n85\t  return '';\n86\t}\n87\t\n88\tasync function runChecks(correct, response, request, ctx) {\n89\t  const fails = [];\n90\t  for (let i = 0; i < correct.length; i++) {\n91\t    const name = correct[i].checkName || `check#${i}`;\n92\t    let v;\n93\t    try { v = await correct[i](response, request, ctx); }\n94\t    catch (err) { fails.push({ check: name, why: `${name} threw: ${String(err && err.message || err).slice(0, 160)}` }); continue; }\n95\t    if (v === true) continue;\n96\t    if (typeof v === 'string') { fails.push({ check: name, why: v }); continue; }\n97\t    if (v && typeof v === 'object' && 'ok' in v) { if (!v.ok) fails.push({ check: name, why: v.why || `${name} failed` }); continue; }\n98\t    // no verdict = fail closed, same law as the core\n99\t    fails.push({ check: name, why: `${name} returned no verdict (fail-closed)` });\n100\t  }\n101\t  return fails;\n102\t}\n103\t\n104\t/**\n105\t * A session: one budget, many wrapped clients/functions.\n106\t * @param {object} opts\n107\t * @param {number} [opts.maxCalls]   hard cap on LLM calls through this session\n108\t * @param {number} [opts.maxTokens]  hard cap on tokens (real provider usage counts)\n109\t * @param {number} [opts.maxRepairs] per-call repair bound (default 0 = no repair)\n110\t * @param {'block'|'observe'} [opts.mode] 'block' (default): a failed call throws\n111\t *   RabadonStop so nothing broken flows onward. 'observe': log + count only —\n112\t *   the Langfuse mode, for the first day in an existing codebase.\n113\t * @param {(ev:string, fields:object)=>void} [opts.emit] live event stream hook\n114\t */\n115\texport function session(opts = {}) {\n116\t  if (!opts.maxCalls && !opts.maxTokens) {\n117\t    throw new Error('rabadon session: set at least one of maxCalls/maxTokens — an unbounded session is a runaway waiting to happen');\n118\t  }\n119\t  const emit = opts.emit || (() => {});\n120\t  const mode = opts.mode || 'block';\n121\t  const state = { calls: 0, tokens: 0, blocked: 0, repaired: 0, observedFails: 0 };\n122\t\n123\t  function gate(label) {\n124\t    if (opts.maxCalls != null && state.calls >= opts.maxCalls) {\n125\t      emit(EV.STOP, { reason: 'RUNAWAY', detail: `maxCalls=${opts.maxCalls} reached before ${label}` });\n126\t      throw new RabadonStop('RUNAWAY', `maxCalls=${opts.maxCalls} reached — refusing \"${label}\" (spent: ${state.calls} calls, ${state.tokens} tokens)`);\n127\t    }\n128\t    if (opts.maxTokens != null && state.tokens >= opts.maxTokens) {\n129\t      emit(EV.STOP, { reason: 'RUNAWAY', detail: `maxTokens=${opts.maxTokens} spent before ${label}` });\n130\t      throw new RabadonStop('RUNAWAY', `maxTokens=${opts.maxTokens} spent — refusing \"${label}\" (spent: ${state.tokens} tokens in ${state.calls} calls)`);\n131\t    }\n132\t  }\n133\t\n134\t  /**\n135\t   * Gate one raw call. The engine under both wrap() and wrapFn().\n136\t   * @param {string} label\n137\t   * @param {() => Promise<any>} doCall     performs the actual provider call\n138\t   * @param {object} request                what was asked (for checks/repair)\n139\t   * @param {object} per                    { correct[], repair, maxRepairs }\n140\t   */\n141\t  async function gated(label, doCall, request, per = {}) {\n142\t    gate(label);\n143\t    state.calls += 1;\n144\t    emit(EV.STEP_START, { step: label, calls: state.calls, tokens: state.tokens });\n145\t\n146\t    let response = await doCall();\n147\t    state.tokens += usageTokens(response);\n148\t\n149\t    const correct = per.correct || [];\n150\t    let fails = await runChecks(correct, response, request, { session: state });"}]},"parent_tool_use_id":"toolu_0192cvfjsyyZKrJXRYLswB6P","session_id":"81910dae-7509-4342-9a27-c75d4f682cbf","uuid":"aadfe09d-2c32-4615-8b22-a2bd2606ed5f","timestamp":"2026-08-24T13:51:34.073Z","subagent_type":"Explore","task_description":"Trace counter in observe mode"}
