{"type":"system","subtype":"task_notification","task_id":"b6f1oa6s0","tool_use_id":"toolu_01MPgDAkc1UffNhmtgB9S5C8","status":"completed","output_file":"","summary":"cd /tmp/rbrun\ntimeout 900 ./.pq/bin/python - <<'PY'\nimport json,urllib.request,io,pyarrow.parquet as pq\nWANT={\"joke2k__faker.8b401a7d.combine_module__5edhgqcy\",\"conan-io__conan.86f29e13.pr_12165\"}\nparts=json.load(urllib.request.urlopen(\"https://huggingface.co/api/datasets/SWE-bench/SWE-smith/parquet/default/train\",timeout=60))\nfound={}; empt=0; tot=0\nfor i,u in enumerate(parts):\n    raw=urllib.request.urlopen(u,timeout=300).read()\n    t=pq.read_table(io.BytesIO(raw),columns=[\"instance_id\",\"problem_statement\",\"repo\",\"FAIL_TO_PASS\",\"PASS_TO_PASS\"])\n    ids=t.column(\"instance_id\").to_pylist(); ps=t.column(\"problem_statement\").to_pylist()\n    tot+=len(ids); empt+=sum(1 for x in ps if not x or not x.strip())\n    for j,x in enumerate(ids):\n        if x in WANT:\n            f2p=t.column(\"FAIL_TO_PASS\")[j].as_py(); p2p=t.column(\"PASS_TO_PASS\")[j].as_py()\n            if isinstance(f2p,str): f2p=json.loads(f2p)\n            if isinstance(p2p,str): p2p=json.loads(p2p)\n            found[x]={\"problem_statement\":ps[j] or \"\",\"repo\":t.column(\"repo\")[j].as_py(),\"F2P\":f2p,\"P2P\":p2p}\nprint(f\"=== dataset geneli: {tot} satir, BOS problem_statement = {empt} ({empt/tot*100:.2f}%)\")\nfor k,v in found.items():\n    p=v[\"problem_statement\"]\n    print(f\"\\n--- {k}\\n  uzunluk={len(p)} F2P={len(v['F2P'])} P2P={len(v['P2P'])}\")\n    print(\"  ilk 200:\",repr(p[:200]))\njson.dump(found,open(\"/tmp/rbrun/ek.json\",\"w\"))\nPY","uuid":"1e34f6bf-39fd-4c14-9b27-20990b96a75a","session_id":"81910dae-7509-4342-9a27-c75d4f682cbf"}
